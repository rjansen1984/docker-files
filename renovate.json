{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "* */6 * * *"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "enabledManagers": [
    "docker-compose"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|\\/)(docker-)?compose\\.ya?ml$/"
    ]
  },
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "description": "Automatically merge Docker patch and minor updates",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Keep MariaDB on the 11.8 Noble release line",
      "matchPackageNames": [
        "/(^|\\/)mariadb$/"
      ],
      "allowedVersions": "/^11\\.8(?:\\.[0-9]+)?-noble$/"
    },
    {
      "description": "Exclude Calibre-Web 5.x",
      "matchPackageNames": [
        "/(^|\\/)calibre-web$/"
      ],
      "allowedVersions": "!/^5(?:\\.|$)/"
    },
    {
      "description": "Exclude Lidarr 8.x",
      "matchPackageNames": [
        "/(^|\\/)lidarr$/"
      ],
      "allowedVersions": "!/^8(?:\\.|$)/"
    }
  ]
}
