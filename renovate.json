{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "enabledManagers": [
    "docker-compose"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|\\/)(docker-)?compose\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "mariadb$"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "calibre-web$"
      ],
      "allowedVersions": "!/^5\\./"
    },
    {
      "matchPackagePatterns": [
        "lidarr$"
      ],
      "allowedVersions": "!/^8\\./"
    }
  ]
}