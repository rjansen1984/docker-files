{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose"],
  "docker-compose": {
    "fileMatch": ["(^|/)(docker-)?compose\\.ya?ml$"]
  },
  "packageRules": [
    {
      "description": "Allow only patch and minor updates in Compose files",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Automatically merge patch and minor Compose updates",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Read LinuxServer images correctly and ignore strange tags",
      "matchPackagePatterns": ["^lscr\\.io/linuxserver/", "^ghcr\\.io/linuxserver/"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<compatibility>.*))?$"
    },
    {
      "description": "Keep MariaDB within 11.x",
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "/^11\\./"
    }
  ]
}
